<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Line icons, drawn on a 24 x 24 grid. Styles pick one by name, e.g. Data="{DynamicResource Icon.Bolt}". -->
    <StreamGeometry x:Key="Icon.Bell">M6,16 V11 A6,6 0 0 1 18,11 V16 L20,18 H4 Z M10,21 H14</StreamGeometry>
    <StreamGeometry x:Key="Icon.Sun">M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,2 V4.5 M12,19.5 V22 M2,12 H4.5 M19.5,12 H22 M5,5 L6.8,6.8 M17.2,17.2 L19,19 M5,19 L6.8,17.2 M17.2,6.8 L19,5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Bolt">M13,3 L5,13 H11 L10,21 L19,10 H13 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Wind">M3,9 H14 A3,3 0 1 0 11,6 M3,15 H18 A3,3 0 1 1 15,18</StreamGeometry>
    <StreamGeometry x:Key="Icon.Dishwasher">M5,4 H19 V20 H5 Z M5,9 H19 M12,12.5 A3,3 0 1 0 12,18.5 A3,3 0 1 0 12,12.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Waves">M3,10 C5,8 7,8 9,10 S13,12 15,10 S19,8 21,10 M3,16 C5,14 7,14 9,16 S13,18 15,16 S19,14 21,16</StreamGeometry>
    <StreamGeometry x:Key="Icon.Drop">M12,3 C12,3 6,10 6,14 A6,6 0 0 0 18,14 C18,10 12,3 12,3 Z</StreamGeometry>
</ResourceDictionary>
